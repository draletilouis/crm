# Production (Railway): use the DATABASE_URL Railway gives the service's own Postgres.
DATABASE_URL=

# Local development: these are used when DATABASE_URL is empty.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=shopmaster
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_SSL=false

# Postgres schema the CRM's tables live in. Leave as public for a database of its own.
# Locally it can share another database by using its own schema, e.g. lefori_crm.
DB_SCHEMA=public

PORT=3030
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Shown in the WhatsApp pitch message agents send.
DEMO_URL=https://lefori.com

# Creates the first manager on startup if no manager exists yet.
BOOTSTRAP_MANAGER_NAME=
BOOTSTRAP_MANAGER_PHONE=
BOOTSTRAP_MANAGER_PIN=
